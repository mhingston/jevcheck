{
  "name": "@mhingston5/jevcheck",
  "version": "0.1.0",
  "description": "Provider-agnostic semantic linting for bounded code-review questions using Jev",
  "license": "MIT",
  "author": "Mark Hingston",
  "repository": {"type": "git", "url": "git+https://github.com/mhingston/jevcheck.git"},
  "bugs": {"url": "https://github.com/mhingston/jevcheck/issues"},
  "homepage": "https://github.com/mhingston/jevcheck#readme",
  "keywords": ["jev", "semantic-lint", "lint", "code-review", "ai"],
  "engines": {"node": ">=20"},
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"}},
  "bin": {"jevcheck": "dist/cli.js"},
  "files": ["dist", "skills", "README.md", "LICENSE"],
  "publishConfig": {"access": "public"},
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests",
    "test:watch": "vitest tests",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.45.3",
    "@mhingston5/jev-cli": "^0.3.0",
    "fast-glob": "^3.3.3",
    "minimatch": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}
