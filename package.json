{
  "name": "@mhingston5/jevcheck",
  "version": "0.6.0",
  "description": "Provider-agnostic semantic linting for bounded code-review questions using Jev",
  "license": "MIT",
  "author": "Mark Hingston",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhingston/jevcheck.git"
  },
  "bugs": {
    "url": "https://github.com/mhingston/jevcheck/issues"
  },
  "homepage": "https://github.com/mhingston/jevcheck#readme",
  "keywords": [
    "jev",
    "semantic-lint",
    "lint",
    "code-review",
    "ai"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "jevcheck": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run tests",
    "test:watch": "vitest tests",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@ast-grep/lang-csharp": "^0.0.6",
    "@ast-grep/lang-go": "0.0.6",
    "@ast-grep/lang-java": "0.0.7",
    "@ast-grep/lang-python": "0.0.6",
    "@ast-grep/lang-rust": "0.0.7",
    "@ast-grep/napi": "^0.45.3",
    "@mhingston5/jev-cli": "^0.4.2",
    "minimatch": "^10.0.1",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "@ast-grep/lang-csharp@0.0.6": true,
    "@ast-grep/lang-go@0.0.6": true,
    "@ast-grep/lang-java@0.0.7": true,
    "@ast-grep/lang-python@0.0.6": true,
    "@ast-grep/lang-rust@0.0.7": true
  }
}
